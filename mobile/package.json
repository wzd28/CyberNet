{
  "name": "cybernet-ai-ios",
  "version": "1.0.0",
  "private": true,
  "description": "CyberNet AI iPhone app (Capacitor 8, SPM). Separate from the website's root dependencies; Netlify never installs this folder.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:gate": "node scripts/check-bundle.test.mjs",
    "check:metadata": "node scripts/check-bundle.mjs --metadata=../docs/app-store/APP-STORE-CONNECT-METADATA.md",
    "native": "node scripts/add-share-extension.cjs",
    "check:native": "node scripts/add-share-extension.cjs --check",
    "sync": "npx cap sync ios && node scripts/add-share-extension.cjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@supabase/supabase-js": "2.117.2",
    "acorn": "8.18.0",
    "esbuild": "0.28.1",
    "jsqr": "1.4.0",
    "parse5": "8.0.1",
    "typescript": "5.9.3",
    "xcode": "3.0.1"
  }
}
